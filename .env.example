# API Settings
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL (Neon) — plain postgresql:// URLs are auto-converted to asyncpg
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# Session
SESSION_SECRET=generate-a-long-random-string
SESSION_COOKIE_NAME=healthpilot_session

# Admin bootstrap (created on first startup if no admin exists)
ADMIN_EMAIL=admin@healthpilot.local
ADMIN_PASSWORD=change-me-on-first-run

# Agent LLM — Mesh API / OpenAI-compatible (external LLM boundary)
# For MeshAPI: OPENAI_BASE_URL=https://api.meshapi.ai/v1 & OPENAI_API_KEY=rsk_your-key-here
# For OpenAI: OPENAI_BASE_URL=https://api.openai.com/v1 & OPENAI_API_KEY=your-key-here

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-proj-your-key-here
LLM_MODEL=openai/gpt-4o
LLM_MODEL_PROVIDER=openai
LLM_TEMPERATURE=0.0

# Embeddings (Mesh API — reuses OPENAI_BASE_URL + OPENAI_API_KEY)
EMBEDDING_MODEL=text-embedding-3-small

# Presidio (embedded in backend)
PRESIDIO_SCORE_THRESHOLD=0.35
PRESIDIO_SPACY_MODEL=en_core_web_lg

# NeMo Guardrails (embedded in backend)
# Leave empty to use bundled src/healthPilot/privacy/nemo_config/
NEMO_CONFIG_PATH=
NEMO_LLM_BASE_URL=https://api.openai.com/v1
NEMO_LLM_API_KEY=sk-proj-your-key-here
NEMO_LLM_MODEL=openai/gpt-4o-mini

# Qdrant Cloud Configuration
# For local Qdrant instance, use: http://localhost:6333
# docker run -p 6333:6333 qdrant/qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Product vector collection
PRODUCTS_COLLECTION=healthpilot_products

# Vector sync job
VECTOR_SYNC_INTERVAL_SECONDS=30
VECTOR_SYNC_MAX_ATTEMPTS=10

# Document Processing Settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval Settings
RETRIEVAL_K=5

# Logging
LOG_LEVEL=INFO

# Langsmith
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# LANGSMITH_API_KEY=XXXXXXXXX
# LANGSMITH_PROJECT=HealthPilot
